{
  "name": "agent-beads",
  "version": "0.1.0",
  "description": "CLI that turns prompts and .md plans into JIRA-style tasks, validates them via the codex-brainstorm skill, and writes them to Beads.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-beads": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
