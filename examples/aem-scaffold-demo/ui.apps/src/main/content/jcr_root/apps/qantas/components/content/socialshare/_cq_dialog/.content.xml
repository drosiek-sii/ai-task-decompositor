<?xml version="1.0" encoding="UTF-8"?>
<!--
  Beads task: jwf — Social Share dialog.
  Toggles per-network availability. Defaults to canonical URL of the page;
  authors may override per instance.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:nt="http://www.jcp.org/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Social Share"
          sling:resourceType="cq/gui/components/authoring/dialog">

    <content jcr:primaryType="nt:unstructured"
             sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <column jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">

                    <facebookEnabled jcr:primaryType="nt:unstructured"
                                     sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                     text="Show Facebook share"
                                     name="./facebookEnabled"
                                     value="{Boolean}true"
                                     uncheckedValue="{Boolean}false"
                                     checked="{Boolean}true"/>

                    <twitterEnabled jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    text="Show Twitter/X share"
                                    name="./twitterEnabled"
                                    value="{Boolean}true"
                                    uncheckedValue="{Boolean}false"
                                    checked="{Boolean}true"/>

                    <printEnabled jcr:primaryType="nt:unstructured"
                                  sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                  text="Show Print button"
                                  name="./printEnabled"
                                  value="{Boolean}true"
                                  uncheckedValue="{Boolean}false"
                                  checked="{Boolean}true"/>

                    <shareUrlOverride jcr:primaryType="nt:unstructured"
                                      sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                      fieldLabel="Share URL override"
                                      fieldDescription="Optional. Defaults to the page canonical URL when blank."
                                      name="./shareUrlOverride"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
